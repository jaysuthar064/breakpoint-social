{
  "name": "breakpoint-social-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "preview": "vite preview --host 127.0.0.1",
    "prerender": "node prerender.js",
    "build:static": "npm run build && npm run prerender",
    "check:env": "node check-env.js",
    "build:release": "node check-env.js && npm run build:static"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "19.2.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.0",
    "react-dom": "19.2.0",
    "vite": "^8.0.0"
  }
}