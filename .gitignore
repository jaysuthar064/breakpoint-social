# Dependencies: reinstallable from package-lock.json.
node_modules/

# Local configuration. On Vercel these come from the project's Environment
# Variables instead, so this file is for local work only.
.env
.env.local

# Build output. Vercel runs the build itself from source, so committing this
# would only ship a stale copy of the site alongside the real one.
dist/
dist-ssr/
.prerender-template.html

# Campaign videos: 239MB across 36 files. Too large for git and for a Vercel
# deploy, so they are served from wherever VITE_VIDEO_BASE points. The source
# files live in ../assets/videos.
public/videos/
